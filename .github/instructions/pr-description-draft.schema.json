{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/.github/instructions/pr-description-draft.schema.json",
  "title": "PR Description Draft Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "base",
    "changedFiles",
    "classifiedSurfaces",
    "title",
    "whyThisTitle",
    "draftBody",
    "checklistDecisions",
    "changelogDecision",
    "evidenceGaps",
    "relatedIssues"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/changedFile"
      }
    },
    "classifiedSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "title": {
      "$ref": "#/$defs/titleDecision"
    },
    "whyThisTitle": {
      "type": "string",
      "minLength": 1
    },
    "draftBody": {
      "type": "string",
      "minLength": 1
    },
    "checklistDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checklistDecision"
      }
    },
    "changelogDecision": {
      "$ref": "#/$defs/changelogDecision"
    },
    "evidenceGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedIssues": {
      "$ref": "#/$defs/relatedIssues"
    }
  },
  "$defs": {
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PRDESC-(PRE|BASE|SCOPE|EVID|TITLE|BODY|CHECK|CHANGELOG|ISSUE|OUT|FAIL)-[0-9]{3}$"
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "selectedReference",
        "selectedCommit",
        "mergeBaseCommit",
        "refreshStatus"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "existing-pr",
            "upstream-main",
            "origin-main",
            "local-main"
          ]
        },
        "selectedReference": {
          "type": "string",
          "minLength": 1
        },
        "selectedCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "mergeBaseCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "refreshStatus": {
          "type": "string",
          "enum": [
            "refreshed",
            "existing-ref-used",
            "not-applicable"
          ]
        },
        "pullRequestNumber": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "source"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "previousPath": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "renamed",
            "copied",
            "deleted",
            "untracked"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "tracked-diff",
            "untracked"
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "changeType",
        "primary",
        "companion",
        "paths"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "resource",
            "data-source",
            "list-resource",
            "action",
            "ephemeral-resource",
            "function",
            "provider-feature",
            "sdk-api-dependency",
            "documentation",
            "contributor-guidance",
            "tests",
            "ci-maintenance",
            "resource-identity",
            "registration",
            "generated-vendored"
          ]
        },
        "terraformName": {
          "type": "string",
          "minLength": 1
        },
        "servicePackage": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "type": "string",
          "enum": [
            "new",
            "enhancement",
            "bug-fix",
            "update",
            "delete",
            "supporting"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "companion": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "titleDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "ruleIds"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    },
    "checklistDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "checked",
        "reason",
        "ruleIds"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "line"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "FEATURES",
            "ENHANCEMENTS",
            "BUG FIXES"
          ]
        },
        "line": {
          "type": "string",
          "pattern": "^\\[(FEATURE|ENHANCEMENT|BUG)\\] \\* .+[^.]$"
        }
      }
    },
    "changelogDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "renderedContent",
        "entries",
        "ruleIds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "recommended",
            "not-recommended",
            "breaking-input-required"
          ]
        },
        "renderedContent": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changelogEntry"
          }
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    },
    "issueCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "url",
        "reason",
        "matchKind"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/hashicorp/terraform-provider-azurerm/issues/[0-9]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "matchKind": {
          "type": "string",
          "enum": [
            "surface",
            "property",
            "behavior-error"
          ]
        }
      }
    },
    "relatedIssues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchStatus",
        "confirmedReferences",
        "candidates",
        "ruleIds"
      ],
      "properties": {
        "searchStatus": {
          "type": "string",
          "enum": [
            "successful",
            "unavailable"
          ]
        },
        "confirmedReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/issueCandidate"
          }
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    }
  }
}
