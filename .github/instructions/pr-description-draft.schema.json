{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/.github/instructions/pr-description-draft.schema.json",
  "title": "PR Description Draft Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repositoryState",
    "existingPullRequest",
    "base",
    "changedFiles",
    "classifiedSurfaces",
    "title",
    "whyThisTitle",
    "draftBody",
    "checklistDecisions",
    "changelogDecision",
    "evidenceGaps",
    "relatedIssues"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.3"
    },
    "repositoryState": {
      "$ref": "#/$defs/repositoryState"
    },
    "existingPullRequest": {
      "$ref": "#/$defs/existingPullRequest"
    },
    "base": {
      "$ref": "#/$defs/base"
    },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/changedFile"
      }
    },
    "classifiedSurfaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/surface"
      }
    },
    "title": {
      "$ref": "#/$defs/titleDecision"
    },
    "whyThisTitle": {
      "type": "string",
      "minLength": 1
    },
    "draftBody": {
      "type": "string",
      "minLength": 1
    },
    "checklistDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/checklistDecision"
      }
    },
    "changelogDecision": {
      "$ref": "#/$defs/changelogDecision"
    },
    "evidenceGaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "relatedIssues": {
      "$ref": "#/$defs/relatedIssues"
    }
  },
  "$defs": {
    "ruleIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^PRDESC-(PRE|PR|BASE|SCOPE|EVID|TITLE|BODY|CHECK|CHANGELOG|ISSUE|OUT|FAIL)-[0-9]{3}$"
      }
    },
    "repositoryState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionBoundary",
        "algorithm",
        "initialFingerprint",
        "finalFingerprint",
        "stable",
        "restartCount"
      ],
      "properties": {
        "executionBoundary": {
          "$ref": "#/$defs/executionBoundary"
        },
        "algorithm": {
          "const": "sha256-v1"
        },
        "initialFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "finalFingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "stable": {
          "const": true
        },
        "restartCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "executionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environmentKind",
        "environmentLabel",
        "worktreeRoot",
        "selectionMethod",
        "gitExecutable",
        "goExecutable",
        "repositoryName",
        "branch",
        "head",
        "knownSourceHead",
        "workingTreeState",
        "candidateCount",
        "searchRoots"
      ],
      "properties": {
        "environmentKind": {
          "type": "string",
          "enum": [
            "current-terminal",
            "wsl-distribution"
          ]
        },
        "environmentLabel": {
          "type": "string",
          "minLength": 1
        },
        "worktreeRoot": {
          "type": "string",
          "minLength": 1
        },
        "selectionMethod": {
          "type": "string",
          "enum": [
            "current-worktree",
            "bounded-search",
            "developer-selection",
            "wsl-native-discovery",
            "translated-current-worktree"
          ]
        },
        "gitExecutable": {
          "type": "string",
          "minLength": 1
        },
        "goExecutable": {
          "type": "string",
          "minLength": 1
        },
        "repositoryName": {
          "const": "terraform-provider-azurerm"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "knownSourceHead": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "workingTreeState": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hasStaged",
            "hasUnstaged",
            "untrackedCount"
          ],
          "properties": {
            "hasStaged": {
              "type": "boolean"
            },
            "hasUnstaged": {
              "type": "boolean"
            },
            "untrackedCount": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "candidateCount": {
          "type": "integer",
          "minimum": 1
        },
        "searchRoots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "evidenceConflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claimType",
        "claim",
        "existingValue",
        "currentEvidence",
        "resolution"
      ],
      "properties": {
        "claimType": {
          "type": "string",
          "enum": [
            "confirmed-reference",
            "testing",
            "description",
            "base"
          ]
        },
        "claim": {
          "type": "string",
          "minLength": 1
        },
        "existingValue": {
          "type": "string",
          "minLength": 1
        },
        "currentEvidence": {
          "type": "string",
          "minLength": 1
        },
        "resolution": {
          "type": "string",
          "enum": [
            "preserved",
            "overridden-by-current-evidence",
            "contributor-confirmation-required"
          ]
        }
      }
    },
    "existingPullRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoveryStatus",
        "trustLevel",
        "localRelation",
        "confirmedReferences",
        "evidenceConflicts",
        "ruleIds"
      ],
      "properties": {
        "discoveryStatus": {
          "type": "string",
          "enum": [
            "found",
            "not-found",
            "unavailable"
          ]
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "merged"
          ]
        },
        "trustLevel": {
          "type": "string",
          "enum": [
            "active-branch-identity",
            "exact-final-head",
            "commit-association-only",
            "none"
          ]
        },
        "headRepository": {
          "type": "string",
          "minLength": 1
        },
        "headBranch": {
          "type": "string",
          "minLength": 1
        },
        "remoteHeadCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "baseReference": {
          "type": "string",
          "minLength": 1
        },
        "baseCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "localRelation": {
          "type": "string",
          "enum": [
            "equal",
            "ahead",
            "behind",
            "diverged",
            "unknown"
          ]
        },
        "confirmedReferences": {
          "description": "Issue references sourced from the identity-trusted pull request before current-evidence conflict resolution.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidenceConflicts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceConflict"
          }
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "discoveryStatus": {
                "const": "found"
              }
            },
            "required": [
              "discoveryStatus"
            ]
          },
          "then": {
            "required": [
              "number",
              "state",
              "headRepository",
              "headBranch",
              "remoteHeadCommit",
              "baseReference"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "discoveryStatus": {
                "enum": [
                  "not-found",
                  "unavailable"
                ]
              }
            },
            "required": [
              "discoveryStatus"
            ]
          },
          "then": {
            "properties": {
              "trustLevel": {
                "const": "none"
              },
              "localRelation": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trustLevel": {
                "const": "active-branch-identity"
              }
            },
            "required": [
              "trustLevel"
            ]
          },
          "then": {
            "required": [
              "baseCommit"
            ],
            "properties": {
              "discoveryStatus": {
                "const": "found"
              },
              "state": {
                "const": "open"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trustLevel": {
                "enum": [
                  "exact-final-head",
                  "commit-association-only"
                ]
              }
            },
            "required": [
              "trustLevel"
            ]
          },
          "then": {
            "properties": {
              "discoveryStatus": {
                "const": "found"
              },
              "localRelation": {
                "const": "unknown"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "trustLevel": {
                "const": "none"
              }
            },
            "required": [
              "trustLevel"
            ]
          },
          "then": {
            "properties": {
              "localRelation": {
                "const": "unknown"
              }
            }
          }
        }
      ]
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "selectedReference",
        "selectedCommit",
        "mergeBaseCommit",
        "refreshStatus"
      ],
      "properties": {
        "source": {
          "type": "string",
          "enum": [
            "existing-pr",
            "upstream-main",
            "origin-main",
            "local-main"
          ]
        },
        "selectedReference": {
          "type": "string",
          "minLength": 1
        },
        "selectedCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "mergeBaseCommit": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,40}$"
        },
        "refreshStatus": {
          "type": "string",
          "enum": [
            "refreshed",
            "existing-ref-used",
            "not-applicable"
          ]
        },
        "pullRequestNumber": {
          "type": "integer",
          "minimum": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "existing-pr"
              }
            },
            "required": [
              "source"
            ]
          },
          "then": {
            "required": [
              "pullRequestNumber"
            ],
            "properties": {
              "refreshStatus": {
                "const": "not-applicable"
              }
            }
          }
        }
      ]
    },
    "changedFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "source"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "previousPath": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "added",
            "modified",
            "renamed",
            "copied",
            "deleted",
            "untracked"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "tracked-diff",
            "untracked"
          ]
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "changeType",
        "primary",
        "companion",
        "paths"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "resource",
            "data-source",
            "list-resource",
            "action",
            "ephemeral-resource",
            "function",
            "provider-feature",
            "sdk-api-dependency",
            "documentation",
            "contributor-guidance",
            "tests",
            "ci-maintenance",
            "resource-identity",
            "registration",
            "generated-vendored"
          ]
        },
        "terraformName": {
          "type": "string",
          "minLength": 1
        },
        "servicePackage": {
          "type": "string",
          "minLength": 1
        },
        "changeType": {
          "type": "string",
          "enum": [
            "new",
            "enhancement",
            "bug-fix",
            "update",
            "delete",
            "supporting"
          ]
        },
        "primary": {
          "type": "boolean"
        },
        "companion": {
          "type": "boolean"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "titleDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "ruleIds"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    },
    "checklistDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "checked",
        "reason",
        "ruleIds"
      ],
      "properties": {
        "item": {
          "type": "string",
          "minLength": 1
        },
        "checked": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    },
    "changelogEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "line"
      ],
      "properties": {
        "category": {
          "type": "string",
          "enum": [
            "FEATURES",
            "ENHANCEMENTS",
            "BUG FIXES"
          ]
        },
        "line": {
          "type": "string",
          "pattern": "^\\[(FEATURE|ENHANCEMENT|BUG)\\] \\* .+[^.]$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "category": {
                "const": "FEATURES"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "line": {
                "pattern": "^\\[FEATURE\\] \\* .+[^.]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "ENHANCEMENTS"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "line": {
                "pattern": "^\\[ENHANCEMENT\\] \\* .+[^.]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "BUG FIXES"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "line": {
                "pattern": "^\\[BUG\\] \\* .+[^.]$"
              }
            }
          }
        }
      ]
    },
    "changelogDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "renderedContent",
        "entries",
        "ruleIds"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "recommended",
            "not-recommended",
            "breaking-input-required"
          ]
        },
        "renderedContent": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/changelogEntry"
          }
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "recommended"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "renderedContent": {
                "pattern": "^\\[(FEATURE|ENHANCEMENT|BUG)\\] \\* [^\\r\\n]+[^.\\r\\n](?:\\r?\\n\\[(FEATURE|ENHANCEMENT|BUG)\\] \\* [^\\r\\n]+[^.\\r\\n])*$"
              },
              "entries": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not-recommended"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "renderedContent": {
                "const": "No changelog entry recommended."
              },
              "entries": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "breaking-input-required"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "renderedContent": {
                "const": "Breaking change; maintainer-managed changelog entry required."
              },
              "entries": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "issueCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "url",
        "reason",
        "matchKind"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://github\\.com/hashicorp/terraform-provider-azurerm/issues/[0-9]+$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "matchKind": {
          "type": "string",
          "enum": [
            "surface",
            "property",
            "behavior-error"
          ]
        }
      }
    },
    "relatedIssues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "searchStatus",
        "confirmedReferences",
        "candidates",
        "ruleIds"
      ],
      "properties": {
        "searchStatus": {
          "type": "string",
          "enum": [
            "successful",
            "unavailable"
          ]
        },
        "confirmedReferences": {
          "description": "Final issue references approved for the generated body from all authoritative sources after conflict resolution.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "candidates": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/issueCandidate"
          }
        },
        "ruleIds": {
          "$ref": "#/$defs/ruleIds"
        }
      }
    }
  }
}
