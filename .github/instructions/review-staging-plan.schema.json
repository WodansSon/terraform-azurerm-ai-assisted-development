{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/.github/instructions/review-staging-plan.schema.json",
  "title": "Pending Pull Request Review Staging Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "repository",
    "sourceReview",
    "adjudication",
    "existingFeedback",
    "reviewBody",
    "comments",
    "expectedCommentCount",
    "expectedFileCoverage",
    "requestChangesSummary"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1"
    },
    "repository": {
      "$ref": "#/$defs/repository"
    },
    "sourceReview": {
      "$ref": "#/$defs/sourceReview"
    },
    "adjudication": {
      "$ref": "#/$defs/adjudication"
    },
    "existingFeedback": {
      "$ref": "#/$defs/existingFeedback"
    },
    "reviewBody": {
      "const": ""
    },
    "comments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comment"
      }
    },
    "expectedCommentCount": {
      "type": "integer",
      "minimum": 1
    },
    "expectedFileCoverage": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requestChangesSummary": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "name",
        "pullNumber",
        "headCommitId"
      ],
      "properties": {
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "pullNumber": {
          "type": "integer",
          "minimum": 1
        },
        "headCommitId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "sourceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "frozen",
        "findings"
      ],
      "properties": {
        "mode": {
          "const": "committed"
        },
        "frozen": {
          "const": true
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/baselineFinding"
          }
        }
      }
    },
    "baselineFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "confidence",
        "summary",
        "snapshot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "issue",
            "observation"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "snapshot": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "challenges",
        "findings"
      ],
      "properties": {
        "state": {
          "const": "settled"
        },
        "challenges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/challenge"
          }
        },
        "findings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/adjudicatedFinding"
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "statement",
        "targetFindingIds",
        "disposition",
        "rationale",
        "resultingFindingIds"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "dispute",
            "missed-finding",
            "clarification"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "targetFindingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "disposition": {
          "type": "string",
          "enum": [
            "accepted",
            "partially-accepted",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "resultingFindingIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "adjudicatedFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "origin",
        "disposition",
        "classification",
        "confidence",
        "summary",
        "rationale"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "enum": [
            "audit",
            "human"
          ]
        },
        "sourceFindingId": {
          "type": "string",
          "minLength": 1
        },
        "disposition": {
          "type": "string",
          "enum": [
            "retained",
            "revised",
            "withdrawn",
            "reclassified",
            "added",
            "suppressed"
          ]
        },
        "classification": {
          "type": "string",
          "enum": [
            "issue",
            "observation"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "existingFeedback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkedHeadCommitId",
        "reviewThreadsComplete",
        "reviewBodiesComplete",
        "discussionCommentsComplete",
        "candidateChecks"
      ],
      "properties": {
        "checkedHeadCommitId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        },
        "reviewThreadsComplete": {
          "const": true
        },
        "reviewBodiesComplete": {
          "const": true
        },
        "discussionCommentsComplete": {
          "const": true
        },
        "candidateChecks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/existingFeedbackCheck"
          }
        }
      }
    },
    "existingFeedbackCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "status",
        "rationale",
        "matches"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "clear",
            "suppressed",
            "distinct-recurrence"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/existingFeedbackReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "suppressed",
                  "distinct-recurrence"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "matches": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "existingFeedbackReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url",
        "author",
        "state",
        "summary"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "review-thread",
            "review-body",
            "discussion-comment"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string",
          "minLength": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "active",
            "open",
            "resolved",
            "outdated"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "unknown"
      ]
    },
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findingId",
        "classification",
        "confidence",
        "path",
        "line",
        "side",
        "body",
        "consolidated",
        "coveredPaths"
      ],
      "properties": {
        "findingId": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "enum": [
            "issue",
            "observation"
          ]
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "type": "string",
          "enum": [
            "LEFT",
            "RIGHT"
          ]
        },
        "body": {
          "type": "string",
          "minLength": 1
        },
        "consolidated": {
          "type": "boolean"
        },
        "coveredPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
