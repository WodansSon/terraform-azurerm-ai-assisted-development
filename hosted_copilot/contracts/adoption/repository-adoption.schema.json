{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hosted Repository Adoption",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "reviewUpstream", "sourceDefinitionSet", "catalog", "protectedRules", "tokenPolicy"],
  "properties": {
    "$schema": { "const": "../../contracts/adoption/repository-adoption.schema.json" },
    "$comment": { "type": "string", "minLength": 1 },
    "schemaVersion": { "const": 1 },
    "reviewUpstream": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*$" },
    "sourceDefinitionSet": { "$ref": "#/$defs/jsonPath" },
    "catalog": { "$ref": "#/$defs/jsonPath" },
    "protectedRules": { "$ref": "#/$defs/jsonPath" },
    "tokenPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimator", "safetyMarginPercent", "maximumGuidanceTokens", "areas", "combinations"],
      "properties": {
        "estimator": { "const": "character-quarter-estimate-v1" },
        "safetyMarginPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "maximumGuidanceTokens": { "$ref": "#/$defs/budget" },
        "areas": {
          "type": "array", "minItems": 1,
          "description": "Allocate each guidance file independently. Multiple skill files use separate named areas, and combinations list the skill areas that apply to each review view.",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "budgetTokens"],
            "oneOf": [{ "required": ["path"] }, { "required": ["surfaceId"] }],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "path": { "$ref": "#/$defs/path" },
              "surfaceId": { "$ref": "#/$defs/name" },
              "budgetTokens": { "$ref": "#/$defs/budget" }
            }
          }
        },
        "combinations": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "members", "budgetTokens"],
            "properties": {
              "name": { "$ref": "#/$defs/name" },
              "members": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } },
              "budgetTokens": { "$ref": "#/$defs/budget" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "path": { "type": "string", "description": "Path relative to the Hosted Toolkit root (hosted_copilot/), not the repository root.", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+$" },
    "jsonPath": { "type": "string", "description": "JSON document path relative to the Hosted Toolkit root (hosted_copilot/). Paths inside the referenced document follow its own contract.", "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9._/-]+\\.json$" },
    "budget": { "type": "integer", "minimum": 1, "maximum": 2147483647 }
  }
}
