{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/instruction-catalog-v4.schema.json",
  "title": "Hosted Instruction Catalog Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "lastSemanticReview", "upstreamSnapshot", "ruleDefaults", "sources", "evidence", "surfaces", "rules", "sourceRelationships"],
  "properties": {
    "$schema": { "const": "instruction-catalog-v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "lastSemanticReview": { "type": "string", "format": "date" },
    "upstreamSnapshot": { "$ref": "#/$defs/upstreamSnapshot" },
    "ruleDefaults": { "$ref": "#/$defs/ruleDefaults" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/evidence" }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/surface" }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    },
    "sourceRelationships": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sourceRelationship" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+-[A-Z0-9]+-[0-9]+[A-Z]?$" },
    "sourceDefinitionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "sourceId": { "type": "string", "minLength": 1, "maxLength": 240 },
    "upstreamSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "baselineCommit", "currentRef"],
      "properties": {
        "repository": { "const": "hashicorp/terraform-provider-azurerm" },
        "baselineCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "currentRef": { "type": "string", "minLength": 1 }
      }
    },
    "ruleDefaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirementLevel", "enforcementMethod", "documentationGap"],
      "properties": {
        "requirementLevel": { "const": "mandatory" },
        "enforcementMethod": { "const": "model-based" },
        "documentationGap": { "const": false }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "rawUrl", "referenceUrl", "baselineSha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "rawUrl": { "type": "string", "format": "uri" },
        "referenceUrl": { "type": "string", "format": "uri" },
        "baselineSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description", "reference"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "type": { "enum": ["source-contract", "maintainer-confirmation", "architecture"] },
        "description": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outputPath", "description", "applyTo", "title", "introduction", "sections", "closing"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "outputPath": { "type": "string", "pattern": "^\\.github/instructions/[a-z0-9-]+\\.instructions\\.md$" },
        "description": { "type": "string", "minLength": 1 },
        "applyTo": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "introduction": { "type": "string", "minLength": 1 },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["heading", "ruleIds"],
            "properties": {
              "heading": { "type": "string", "minLength": 1 },
              "ruleIds": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/ruleId" }
              }
            }
          }
        },
        "closing": { "type": "string", "minLength": 1 }
      }
    },
    "selectionFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoringStatus"],
      "properties": {
        "scoringStatus": { "enum": ["scored", "not-applicable"] },
        "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "frequency": { "type": "integer", "minimum": 0, "maximum": 5 },
        "breadth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "hostedDetectability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "falsePositiveRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "redundancy": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [
        {
          "if": { "properties": { "scoringStatus": { "const": "scored" } } },
          "then": { "required": ["severity", "frequency", "breadth", "hostedDetectability", "evidenceStrength", "falsePositiveRisk", "redundancy"] }
        }
      ]
    },
    "foundationalOverride": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["rationale", "affectedHostedRuleIds", "affectedSurfaces"],
          "properties": {
            "rationale": { "type": "string", "minLength": 1 },
            "affectedHostedRuleIds": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/ruleId" }
            },
            "affectedSurfaces": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["repository", "implementation", "testing", "documentation", "review-skill"] }
            }
          }
        },
        { "type": "null" }
      ]
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "status", "text", "provenance", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/ruleId" },
        "origin": { "enum": ["hosted-baseline-migration", "hosted-catalog-addition"] },
        "status": { "enum": ["active", "retired"] },
        "text": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["published-upstream-standard", "confirmed-maintainer-convention", "inferred-maintainer-convention", "local-safeguard"]
          }
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        },
        "implementationModels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["legacy", "typed", "framework"] }
        },
        "documentationGap": { "type": "boolean" },
        "retirementReason": { "type": "string", "minLength": 1 },
        "selectionFactors": { "$ref": "#/$defs/selectionFactors" },
        "selectionRationale": { "type": "string", "minLength": 1 },
        "foundationalOverride": { "$ref": "#/$defs/foundationalOverride" }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "pattern": "^IMPL-" } } },
          "then": { "required": ["implementationModels"] },
          "else": { "not": { "required": ["implementationModels"] } }
        },
        {
          "if": { "properties": { "status": { "const": "retired" } } },
          "then": { "required": ["retirementReason"] }
        }
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDefinitionId", "sourceId"],
      "properties": {
        "sourceDefinitionId": { "$ref": "#/$defs/sourceDefinitionId" },
        "sourceId": { "$ref": "#/$defs/sourceId" }
      }
    },
    "assessmentEvidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentBaselineSha256", "contentSha256", "assessmentId"],
      "properties": {
        "assessmentBaselineSha256": { "$ref": "#/$defs/sha256" },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "assessmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" }
      }
    },
    "relationshipHistory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "recordedAt", "rationale", "assessmentEvidenceRefs"],
      "properties": {
        "action": { "enum": ["retired", "restored", "evidence-refreshed"] },
        "recordedAt": { "type": "string", "format": "date-time" },
        "rationale": { "type": "string", "minLength": 1 },
        "assessmentEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/assessmentEvidenceRef" }
        }
      }
    },
    "sourceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "hostedRuleId", "status", "relationshipKind", "assessmentEvidenceRefs", "rationale", "acceptedAt", "history"],
      "properties": {
        "sourceRef": { "$ref": "#/$defs/sourceRef" },
        "hostedRuleId": { "$ref": "#/$defs/ruleId" },
        "status": { "enum": ["active", "retired"] },
        "relationshipKind": { "enum": ["supports", "equivalent", "included"] },
        "assessmentEvidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/assessmentEvidenceRef" }
        },
        "rationale": { "type": "string", "minLength": 1 },
        "acceptedAt": { "type": "string", "format": "date-time" },
        "retirementReason": { "type": "string", "minLength": 1 },
        "history": {
          "type": "array",
          "items": { "$ref": "#/$defs/relationshipHistory" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "retired" } } },
          "then": { "required": ["retirementReason"] },
          "else": { "not": { "required": ["retirementReason"] } }
        }
      ]
    }
  }
}
