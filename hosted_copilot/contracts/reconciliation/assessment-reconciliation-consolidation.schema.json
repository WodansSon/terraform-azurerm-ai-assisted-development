{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "shardKey", "groups"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hosted-assessment-consolidation-result" },
    "shardKey": { "type": "string", "minLength": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["componentKeys", "semanticSummary"],
        "properties": {
          "componentKeys": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^component:[0-9a-f]{64}$" }
          },
          "semanticSummary": { "type": "string", "minLength": 1, "maxLength": 1200 }
        }
      }
    }
  }
}
