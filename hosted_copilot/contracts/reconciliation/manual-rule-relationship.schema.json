{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/manual-rule-relationship.schema.json",
  "title": "Hosted Manual Rule Relationship Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "ruleTextSha256", "relationships"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "ruleTextSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "$defs": {
    "hostedId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$"
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedRuleId", "relationship", "rationale"],
      "properties": {
        "hostedRuleId": {
          "$ref": "#/$defs/hostedId"
        },
        "relationship": {
          "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "suggestedConsolidatedText": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
