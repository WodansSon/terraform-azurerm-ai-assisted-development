{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/rule-issue-adjudication-input-v4.schema.json",
  "title": "Hosted Rule Issue Adjudication Input V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "componentId", "sourceFiles", "rules", "relationships", "operations"],
  "properties": {
    "$schema": { "const": "rule-issue-adjudication-input-v4.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hosted-rule-issue-adjudication-input" },
    "componentId": { "type": "string", "minLength": 1 },
    "evaluationPhase": { "enum": ["scope", "assessment", "relationships", "issues"] },
    "evaluationContextSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "scopeReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "ownerRuleId", "baselineQuote", "proposalQuote", "rationale", "wordingStatus", "wordingRationale"],
      "properties": {
        "disposition": { "enum": ["within-scope", "route-to-existing-rule", "suggest-new-rule", "uncertain"] },
        "ownerRuleId": { "type": ["string", "null"] },
        "baselineQuote": { "type": "string", "minLength": 1 },
        "proposalQuote": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 },
        "wordingStatus": { "enum": ["acceptable", "needs-review"] },
        "wordingRationale": { "type": "string", "minLength": 1 }
      }
    },
    "memberScopeReviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateKey", "scopeReview"],
        "properties": {
          "candidateKey": { "type": "string", "minLength": 1 },
          "scopeReview": { "$ref": "#/properties/scopeReview" }
        }
      }
    },
    "sourceFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceDefinitionId", "sourceId", "contentSha256"],
        "properties": {
          "sourceDefinitionId": { "type": "string", "minLength": 1 },
          "sourceId": { "type": "string", "minLength": 1 },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "title", "text", "contentSha256", "candidateKeys"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "status": { "enum": ["protected", "active", "retired", "proposed"] },
          "title": { "type": "string", "minLength": 1 },
          "text": { "type": "string", "minLength": 1 },
          "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "candidateKeys": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
        }
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sourceRuleId", "relatedRuleId", "relationship", "rationale", "candidateKey"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "sourceRuleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "relatedRuleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "relationship": { "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts"] },
          "rationale": { "type": "string", "minLength": 1 },
          "candidateKey": { "type": "string", "minLength": 1 }
        }
      }
    },
    "editContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidateKey", "baselineText", "baselineSha256", "appendText", "evaluationContextSha256", "proposals"],
      "properties": {
        "candidateKey": { "type": "string", "minLength": 1 },
        "intendedCandidateKey": { "type": "string", "minLength": 1 },
        "baselineText": { "type": "string", "minLength": 1 },
        "baselineSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "appendText": { "type": ["string", "null"] },
        "evaluationContextSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "assessmentContext": {
          "type": "object",
          "additionalProperties": false,
          "required": ["catalogRules", "sources"],
          "properties": {
            "catalogRules": { "type": "array", "items": { "$ref": "#/properties/rules/items" } },
            "sources": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["candidateKey", "category", "sourceRules"],
                "properties": {
                  "candidateKey": { "type": "string", "minLength": 1 },
                  "category": { "enum": ["repository", "implementation", "testing", "documentation", "review-skill"] },
                  "sourceRules": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["id", "text", "meaning"],
                      "properties": {
                        "id": { "type": "string", "minLength": 1 },
                        "text": { "type": "string", "minLength": 1 },
                        "meaning": { "type": "string", "minLength": 1 }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "proposals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidateKey", "inPlan", "baselineText", "proposedText", "ruleTextSha256", "retireHostedRuleIds"],
            "properties": {
              "candidateKey": { "type": "string", "minLength": 1 },
              "inPlan": { "type": "boolean" },
              "baselineText": { "type": "string", "minLength": 1 },
              "proposedText": { "type": "string", "minLength": 1 },
              "ruleTextSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
              "retireHostedRuleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["candidateKey", "ruleId", "action", "proposedText", "retireHostedRuleIds"],
        "properties": {
          "candidateKey": { "type": "string", "minLength": 1 },
          "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "action": { "enum": ["add", "update", "no-change", "retire", "restore", "exclude", "defer"] },
          "proposedText": { "type": "string", "minLength": 1 },
          "retireHostedRuleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "evaluationPhase": { "const": "relationships" } }, "required": ["evaluationPhase"] },
      "then": { "required": ["evaluationContextSha256"], "not": { "required": ["editContext"] } },
      "else": {
        "if": { "properties": { "evaluationPhase": { "enum": ["scope", "issues"] } }, "required": ["evaluationPhase"] },
        "then": {
          "required": ["editContext"],
          "if": { "properties": { "evaluationPhase": { "const": "issues" } } },
          "then": { "required": ["scopeReview", "memberScopeReviews"] }
        },
        "else": {
          "properties": { "editContext": { "required": ["assessmentContext"] } },
          "if": { "required": ["evaluationPhase"] },
          "then": { "required": ["editContext"] }
        }
      }
    },
    {
      "if": { "not": { "required": ["editContext"] } },
      "then": { "properties": { "rules": { "minItems": 2 }, "relationships": { "minItems": 1 } } }
    }
  ]
}
