{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "id", "displayName", "root", "files", "parser", "assessmentBatchSize"],
  "properties": {
    "$schema": {
      "const": "source-definition.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "root": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "path"],
          "properties": {
            "kind": {
              "const": "repository"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "repository", "ref", "path"],
          "properties": {
            "kind": {
              "const": "github"
            },
            "repository": {
              "const": "hashicorp/terraform-provider-azurerm"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9._/-]+$"
            },
            "path": {
              "$ref": "#/$defs/relativePath"
            }
          }
        }
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/filePattern"
      }
    },
    "exclude": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/filePattern"
      }
    },
    "parser": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"
    },
    "assessmentBatchSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$"
    },
    "filePattern": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._*/-]+$"
    }
  }
}
