{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/regression/workbench/behavior-manifest.schema.json",
  "title": "Hosted Workbench browser behavior manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authority", "targetHarness", "behaviors"],
  "properties": {
    "$schema": {
      "const": "behavior-manifest.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "authority": {
      "const": "hosted_copilot/docs/HOSTED_COPILOT_CODE_REVIEW_IMPLEMENTATION.md"
    },
    "targetHarness": {
      "const": "playwright"
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "journey"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WB-UX-[A-Z]+-[0-9]{3}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "journey": {
            "type": "string",
            "pattern": "^playwright/journeys/[a-z0-9-]+\\.journey\\.cjs$"
          }
        }
      }
    }
  }
}
