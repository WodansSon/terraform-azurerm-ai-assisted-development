{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/approved-rules-v4.schema.json",
  "title": "Hosted Approved Rules Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "catalogContentSha256", "approvedAt", "approvedBy", "mutations"],
  "properties": {
    "$schema": { "const": "approved-rules-v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "kind": { "const": "hosted-approved-rules" },
    "catalogContentSha256": { "$ref": "#/$defs/sha256" },
    "approvedAt": { "type": "string", "format": "date-time" },
    "approvedBy": { "$ref": "#/$defs/identity" },
    "mutations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/mutation" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hostedId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": { "enum": ["github-authenticated", "git-config", "manual"] },
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surfaceId", "sectionHeading"],
      "properties": {
        "surfaceId": { "enum": ["implementation", "testing", "documentation"] },
        "sectionHeading": { "type": "string", "minLength": 1 }
      }
    },
    "selectionFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoringStatus"],
      "properties": {
        "scoringStatus": { "enum": ["scored", "not-applicable"] },
        "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "frequency": { "type": "integer", "minimum": 0, "maximum": 5 },
        "breadth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "hostedDetectability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "falsePositiveRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "redundancy": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [
        {
          "if": { "properties": { "scoringStatus": { "const": "scored" } }, "required": ["scoringStatus"] },
          "then": { "required": ["severity", "frequency", "breadth", "hostedDetectability", "evidenceStrength", "falsePositiveRisk", "redundancy"] }
        }
      ]
    },
    "catalogRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "origin", "status", "text", "provenance", "evidenceIds"],
      "properties": {
        "id": { "$ref": "#/$defs/hostedId" },
        "origin": { "enum": ["hosted-baseline-migration", "hosted-catalog-addition"] },
        "status": { "enum": ["active", "retired"] },
        "text": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["published-upstream-standard", "confirmed-maintainer-convention", "inferred-maintainer-convention", "local-safeguard"] }
        },
        "evidenceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" } },
        "implementationModels": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["legacy", "typed", "framework"] } },
        "documentationGap": { "type": "boolean" },
        "retirementReason": { "type": "string", "minLength": 1 },
        "lastPlacement": { "$ref": "#/$defs/placement" },
        "selectionFactors": { "$ref": "#/$defs/selectionFactors" },
        "selectionRationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "id": { "pattern": "^IMPL-" } }, "required": ["id"] },
          "then": { "required": ["implementationModels"] },
          "else": { "not": { "required": ["implementationModels"] } }
        },
        {
          "if": { "properties": { "status": { "const": "retired" } }, "required": ["status"] },
          "then": { "required": ["retirementReason", "lastPlacement"] },
          "else": {
            "not": {
              "anyOf": [
                { "required": ["retirementReason"] },
                { "required": ["lastPlacement"] }
              ]
            }
          }
        }
      ]
    },
    "sourceRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDefinitionId", "sourceId", "relationshipKind", "rationale"],
      "properties": {
        "sourceDefinitionId": { "enum": ["contributor-guidance", "interactive-toolkit", "maintainer-proposals"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "relationshipKind": { "enum": ["supports", "equivalent", "included"] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "canonicalCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDefinitionId", "sourceId"],
      "properties": {
        "sourceDefinitionId": { "enum": ["contributor-guidance", "interactive-toolkit", "maintainer-proposals"] },
        "sourceId": { "type": "string", "minLength": 1, "maxLength": 240 },
        "assessmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" }
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "rationale", "rule", "canonicalCandidate", "placements", "sourceRelationships"],
      "properties": {
        "action": { "enum": ["add", "update", "retire", "restore"] },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
        "rule": { "$ref": "#/$defs/catalogRule" },
        "canonicalCandidate": { "$ref": "#/$defs/canonicalCandidate" },
        "placements": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/placement" } },
        "sourceRelationships": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/sourceRelationship" } }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "enum": ["add", "update", "restore"] } }, "required": ["action"] },
          "then": {
            "properties": {
              "rule": { "allOf": [{ "$ref": "#/$defs/catalogRule" }, { "properties": { "status": { "const": "active" } } }] },
              "placements": { "minItems": 1 }
            }
          }
        },
        {
          "if": { "properties": { "action": { "const": "retire" } }, "required": ["action"] },
          "then": {
            "properties": {
              "rule": { "allOf": [{ "$ref": "#/$defs/catalogRule" }, { "properties": { "status": { "const": "retired" } } }] },
              "placements": { "maxItems": 0 }
            }
          }
        }
      ]
    }
  }
}
