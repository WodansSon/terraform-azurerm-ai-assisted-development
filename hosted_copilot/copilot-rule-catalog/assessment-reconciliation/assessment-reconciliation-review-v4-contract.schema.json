{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/assessment-reconciliation-review-v4-contract.schema.json",
  "title": "Hosted Assessment Reconciliation Review Contract Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractId", "behaviorFiles"],
  "properties": {
    "$schema": {
      "const": "assessment-reconciliation-review-v4-contract.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "contractId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"
    },
    "behaviorFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    }
  }
}
