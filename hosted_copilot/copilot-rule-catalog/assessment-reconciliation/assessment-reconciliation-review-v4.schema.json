{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/assessment-reconciliation-review-v4.schema.json",
  "title": "Hosted Assessment Reconciliation Review",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "readOnly", "refreshMode", "snapshots", "sourceDefinitions", "acceptedSourceGeneration", "stagedInventories", "assessmentBaseline", "recommendationOutput", "hostedCatalog", "guidanceCapacity", "summary", "assessmentPresentations"],
  "properties": {
    "$schema": {
      "const": "assessment-reconciliation-review-v4.schema.json"
    },
    "schemaVersion": {
      "const": 4
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "readOnly": {
      "const": true
    },
    "refreshMode": {
      "const": "regenerate-read-only-review"
    },
    "snapshots": {
      "$ref": "#/$defs/snapshots"
    },
    "sourceDefinitions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sourceDefinitionMetadata"
      }
    },
    "acceptedSourceGeneration": {
      "oneOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "stagedInventories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "assessmentBaseline": {
      "type": "object"
    },
    "recommendationOutput": {
      "type": "object"
    },
    "hostedCatalog": {
      "type": "object"
    },
    "guidanceCapacity": {
      "$ref": "#/$defs/guidanceCapacity"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "assessmentPresentations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessmentPresentation"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hostedId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$"
    },
    "hashMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stagedInventoryHashes", "acceptedSourceGenerationSha256", "assessmentBaselineSha256", "hostedCatalogSha256", "guidanceCapacitySha256", "reconciliationContractSha256", "reviewContractSha256"],
      "properties": {
        "stagedInventoryHashes": {
          "$ref": "#/$defs/hashMap"
        },
        "acceptedSourceGenerationSha256": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "assessmentBaselineSha256": {
          "$ref": "#/$defs/sha256"
        },
        "hostedCatalogSha256": {
          "$ref": "#/$defs/sha256"
        },
        "guidanceCapacitySha256": {
          "$ref": "#/$defs/sha256"
        },
        "reconciliationContractSha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewContractSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourceDefinitionMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDefinitionSha256", "inventoryConfigurationSha256", "parserId", "parserContractSha256", "sourceRevision"],
      "properties": {
        "sourceDefinitionSha256": { "$ref": "#/$defs/sha256" },
        "inventoryConfigurationSha256": { "$ref": "#/$defs/sha256" },
        "parserId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$" },
        "parserContractSha256": { "$ref": "#/$defs/sha256" },
        "sourceRevision": { "type": "object" }
      }
    },
    "capacityReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "paths", "characterCount", "estimatedTokens", "guardedTokens", "budgetTokens", "budgetHeadroomTokens", "utilizationPercent", "withinBudget"],
      "properties": {
        "name": { "enum": ["repository", "go", "test", "documentation", "skill", "go-combined", "test-combined", "documentation-combined"] },
        "kind": { "enum": ["file", "combined"] },
        "paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "characterCount": { "type": "integer", "minimum": 0 },
        "estimatedTokens": { "type": "integer", "minimum": 0 },
        "guardedTokens": { "type": "integer", "minimum": 0 },
        "budgetTokens": { "type": "integer", "minimum": 1 },
        "budgetHeadroomTokens": { "type": "integer" },
        "utilizationPercent": { "type": "number", "minimum": 0 },
        "withinBudget": { "type": "boolean" }
      }
    },
    "guidanceCapacity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "estimator", "safetyMarginPercent", "reportCount", "reports"],
      "properties": {
        "status": { "enum": ["passed", "failed"] },
        "estimator": { "const": "character-quarter-estimate-25pct-v1" },
        "safetyMarginPercent": { "const": 25 },
        "reportCount": { "const": 8 },
        "reports": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/capacityReport" }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceCount", "assessmentCount", "recommendationCount", "reviewStateCounts"],
      "properties": {
        "sourceCount": {
          "type": "integer",
          "minimum": 1
        },
        "assessmentCount": {
          "type": "integer",
          "minimum": 1
        },
        "recommendationCount": {
          "type": "integer",
          "minimum": 0
        },
        "reviewStateCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["recommended", "deferred", "excluded"],
          "properties": {
            "recommended": {
              "type": "integer",
              "minimum": 0
            },
            "deferred": {
              "type": "integer",
              "minimum": 0
            },
            "excluded": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentBaselineSha256", "sourceDefinitionId", "sourceId", "contentSha256", "assessmentId"],
      "properties": {
        "assessmentBaselineSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceDefinitionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        }
      }
    },
    "relatedHostedCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedRuleId", "relationship", "rationale", "assessmentRefs"],
      "properties": {
        "hostedRuleId": {
          "$ref": "#/$defs/hostedId"
        },
        "relationship": {
          "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts", "related", "none"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "assessmentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessmentRef"
          }
        }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedId", "idState", "recommendedAction", "title", "recommendedRuleText", "category", "placement", "rationale", "needsReview", "memberAssessmentRefs", "relatedHostedCoverage", "tokenProjection"],
      "properties": {
        "hostedId": {
          "$ref": "#/$defs/hostedId"
        },
        "idState": {
          "enum": ["existing", "tentative"]
        },
        "recommendedAction": {
          "enum": ["add", "update", "no-change", "defer"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "recommendedRuleText": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["implementation", "testing", "documentation"]
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "needsReview": {
          "type": "boolean"
        },
        "memberAssessmentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessmentRef"
          }
        },
        "relatedHostedCoverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedHostedCoverage"
          }
        },
        "tokenProjection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["estimatedTokenDelta", "guardedTokenDelta"],
          "properties": {
            "estimatedTokenDelta": {
              "type": "integer"
            },
            "guardedTokenDelta": {
              "type": "integer"
            }
          }
        }
      }
    },
    "assessmentPresentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentRef", "sourceTransition", "reviewState", "hostedCategory", "hostedId", "guardedTokenDelta", "recommendation"],
      "properties": {
        "assessmentRef": {
          "$ref": "#/$defs/assessmentRef"
        },
        "sourceTransition": {
          "enum": ["current", "added", "changed", "moved", "source-lifecycle-changed", "removed", "reappeared"]
        },
        "reviewState": {
          "enum": ["recommended", "deferred", "excluded"]
        },
        "hostedCategory": {
          "enum": ["unassigned", "implementation", "testing", "documentation"]
        },
        "hostedId": {
          "oneOf": [
            {
              "$ref": "#/$defs/hostedId"
            },
            {
              "type": "null"
            }
          ]
        },
        "guardedTokenDelta": {
          "type": "integer"
        },
        "recommendation": {
          "enum": ["add", "update", "no-change", "defer", "exclude"]
        }
      }
    }
  }
}
