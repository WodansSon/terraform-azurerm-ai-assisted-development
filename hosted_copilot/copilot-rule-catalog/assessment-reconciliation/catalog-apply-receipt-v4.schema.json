{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/catalog-apply-receipt-v4.schema.json",
  "title": "Hosted Catalog Apply Receipt Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "receiptId", "appliedAt", "workbenchBundleSha256", "promotionPlanSha256", "previewPayloadSha256", "sourceGenerationSha256", "priorCatalogSha256", "resultingCatalogSha256", "appliedMutations", "appliedBy", "validations", "outcome"],
  "properties": {
    "$schema": { "const": "catalog-apply-receipt-v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "kind": { "const": "hosted-catalog-apply-receipt" },
    "receiptId": { "type": "string", "format": "uuid" },
    "appliedAt": { "type": "string", "format": "date-time" },
    "workbenchBundleSha256": { "$ref": "#/$defs/sha256" },
    "promotionPlanSha256": { "$ref": "#/$defs/sha256" },
    "previewPayloadSha256": { "$ref": "#/$defs/sha256" },
    "sourceGenerationSha256": { "$ref": "#/$defs/sha256" },
    "priorCatalogSha256": { "$ref": "#/$defs/sha256" },
    "resultingCatalogSha256": { "$ref": "#/$defs/sha256" },
    "appliedMutations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/appliedMutation" }
    },
    "appliedBy": { "$ref": "#/$defs/identity" },
    "validations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "outcome": { "const": "success" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hostedId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": { "enum": ["github-authenticated", "git-config", "manual"] },
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "appliedMutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "hostedId"],
      "properties": {
        "action": { "enum": ["add", "update", "retire", "restore"] },
        "hostedId": { "$ref": "#/$defs/hostedId" }
      }
    }
  }
}
