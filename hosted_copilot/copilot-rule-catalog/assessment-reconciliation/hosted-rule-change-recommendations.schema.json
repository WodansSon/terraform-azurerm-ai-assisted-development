{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/hosted-rule-change-recommendations.schema.json",
  "title": "Hosted Rule Change Recommendations",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "inventoryHashes", "assessmentBaselineSha256", "hostedCatalogSha256", "reconciliationContractSha256", "recommendations", "assessmentCoverage"],
  "properties": {
    "$schema": {
      "const": "hosted-rule-change-recommendations.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "inventoryHashes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "assessmentBaselineSha256": {
      "$ref": "#/$defs/sha256"
    },
    "hostedCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "reconciliationContractSha256": {
      "$ref": "#/$defs/sha256"
    },
    "recommendations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/hostedRuleChangeRecommendation"
      }
    },
    "assessmentCoverage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/assessmentCoverage"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "hostedId": {
      "type": "string",
      "maxLength": 32,
      "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$"
    },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentBaselineSha256", "sourceDefinitionId", "sourceId", "contentSha256", "assessmentId"],
      "properties": {
        "assessmentBaselineSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceDefinitionId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "contentSha256": {
          "$ref": "#/$defs/sha256"
        },
        "assessmentId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9-]*$"
        }
      }
    },
    "relatedHostedCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedRuleId", "relationship", "rationale", "assessmentRefs"],
      "properties": {
        "hostedRuleId": {
          "$ref": "#/$defs/hostedId"
        },
        "relationship": {
          "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts", "related", "none"]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "assessmentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessmentRef"
          }
        }
      }
    },
    "tokenProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimatedTokenDelta", "guardedTokenDelta"],
      "properties": {
        "estimatedTokenDelta": {
          "type": "integer"
        },
        "guardedTokenDelta": {
          "type": "integer"
        }
      }
    },
    "hostedRuleChangeRecommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedId", "idState", "recommendedAction", "title", "recommendedRuleText", "category", "placement", "rationale", "needsReview", "memberAssessmentRefs", "relatedHostedCoverage", "tokenProjection"],
      "properties": {
        "hostedId": {
          "$ref": "#/$defs/hostedId"
        },
        "idState": {
          "enum": ["existing", "tentative"]
        },
        "recommendedAction": {
          "enum": ["add", "update", "no-change", "defer"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "recommendedRuleText": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": ["implementation", "testing", "documentation"]
        },
        "placement": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "needsReview": {
          "type": "boolean"
        },
        "memberAssessmentRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/assessmentRef"
          }
        },
        "relatedHostedCoverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relatedHostedCoverage"
          }
        },
        "tokenProjection": {
          "$ref": "#/$defs/tokenProjection"
        }
      }
    },
    "assessmentCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentRef", "disposition", "rationale", "hostedIds"],
      "properties": {
        "assessmentRef": {
          "$ref": "#/$defs/assessmentRef"
        },
        "disposition": {
          "enum": ["recommended", "deferred", "excluded"]
        },
        "rationale": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "hostedIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hostedId"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "recommended"
              }
            },
            "required": ["disposition"]
          },
          "then": {
            "properties": {
              "rationale": {
                "type": "null"
              },
              "hostedIds": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "hostedIds": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
