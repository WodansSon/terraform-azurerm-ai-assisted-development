{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/promotion-plan-v4.schema.json",
  "title": "Hosted Rule Promotion Plan Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "planId", "createdAt", "sourceWorkbenchBundleSha256", "basePromotionPlanSha256", "hostedCatalogSha256", "items"],
  "properties": {
    "$schema": { "const": "promotion-plan-v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "kind": { "const": "hosted-rule-promotion-plan" },
    "planId": { "type": "string", "format": "uuid" },
    "createdAt": { "type": "string", "format": "date-time" },
    "sourceWorkbenchBundleSha256": { "$ref": "#/$defs/sha256" },
    "basePromotionPlanSha256": { "oneOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
    "hostedCatalogSha256": { "$ref": "#/$defs/sha256" },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hostedId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentBaselineSha256", "sourceDefinitionId", "sourceId", "contentSha256", "assessmentId"],
      "properties": {
        "assessmentBaselineSha256": { "$ref": "#/$defs/sha256" },
        "sourceDefinitionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "assessmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" }
      }
    },
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "ruleText", "category", "placement"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "ruleText": { "type": "string", "minLength": 1 },
        "category": { "enum": ["implementation", "testing", "documentation"] },
        "placement": { "type": "string", "minLength": 1 }
      }
    },
    "tokenProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimatedTokenDelta", "guardedTokenDelta"],
      "properties": {
        "estimatedTokenDelta": { "type": "integer" },
        "guardedTokenDelta": { "type": "integer" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedId", "idState", "recommendationSha256", "action", "recommendation", "memberAssessmentRefs", "rationale", "tokenProjection", "reviewStatus", "updatedAt"],
      "properties": {
        "hostedId": { "$ref": "#/$defs/hostedId" },
        "idState": { "enum": ["existing", "tentative"] },
        "recommendationSha256": { "$ref": "#/$defs/sha256" },
        "action": { "enum": ["add", "update", "retire", "restore", "no-change", "defer"] },
        "recommendation": { "$ref": "#/$defs/recommendation" },
        "memberAssessmentRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessmentRef" } },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
        "tokenProjection": { "$ref": "#/$defs/tokenProjection" },
        "reviewStatus": { "enum": ["current", "needs-review"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "action": { "const": "add" } }, "required": ["action"] },
          "then": { "properties": { "idState": { "const": "tentative" } } }
        },
        {
          "if": { "properties": { "action": { "enum": ["update", "retire", "restore", "no-change"] } }, "required": ["action"] },
          "then": { "properties": { "idState": { "const": "existing" } } }
        }
      ]
    }
  }
}
