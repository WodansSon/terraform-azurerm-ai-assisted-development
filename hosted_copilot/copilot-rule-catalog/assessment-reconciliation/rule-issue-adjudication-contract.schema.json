{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/rule-issue-adjudication-contract.schema.json",
  "title": "Hosted Rule Issue Adjudication Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "contractId", "behaviorFiles"],
  "properties": {
    "$schema": { "const": "rule-issue-adjudication-contract.schema.json" },
    "schemaVersion": { "const": 1 },
    "contractId": { "const": "rule-issue-adjudication-v4" },
    "behaviorFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    }
  }
}
