{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/rule-issue-adjudication-draft-v4.schema.json",
  "title": "Hosted Rule Issue Adjudication Draft V4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "componentId", "relationshipDecisions", "issues"],
  "properties": {
    "$schema": { "const": "rule-issue-adjudication-draft-v4.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hosted-rule-issue-adjudication-draft" },
    "componentId": { "type": "string", "minLength": 1 },
    "relationshipDecisions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relationshipId", "disposition", "relationship", "rationale"],
        "properties": {
          "relationshipId": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["issue", "independent"] },
          "relationship": { "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts", "none"] },
          "rationale": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": { "properties": { "disposition": { "const": "independent" } }, "required": ["disposition"] },
            "then": { "properties": { "relationship": { "const": "none" } } },
            "else": { "properties": { "relationship": { "enum": ["equivalent", "partial-overlap", "assessment-extends-hosted", "assessment-narrows-hosted", "conflicts"] } } }
          }
        ]
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["anchorRuleId", "classification", "title", "bannerTitle", "bannerMessage", "blocking", "ruleIds", "relationshipIds", "ruleDispositions", "assessmentSummary", "wording", "recommendedMaintainerAction"],
        "properties": {
          "anchorRuleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
          "classification": { "enum": ["protected-integrity", "protected-conflict", "protected-coverage", "contradiction", "duplicate", "overlap"] },
          "title": { "type": "string", "minLength": 1, "maxLength": 160 },
          "bannerTitle": { "type": "string", "minLength": 1, "maxLength": 160 },
          "bannerMessage": { "type": "string", "minLength": 1, "maxLength": 400 },
          "blocking": { "type": "boolean" },
          "ruleIds": { "type": "array", "minItems": 2, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } },
          "relationshipIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
          "ruleDispositions": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["ruleId", "disposition"],
              "properties": {
                "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
                "disposition": { "enum": ["keep", "promote", "replace", "retire", "exclude", "defer", "review"] }
              }
            }
          },
          "assessmentSummary": { "type": "string", "minLength": 1, "maxLength": 600 },
          "wording": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "label", "presentation", "text", "sourceRuleId"],
                "properties": {
                  "status": { "enum": ["canonical", "selected"] },
                  "label": { "enum": ["Canonical Protected Wording", "Suggested Consolidated Wording"] },
                  "presentation": { "enum": ["section", "member"] },
                  "text": { "type": "string", "minLength": 1 },
                  "sourceRuleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "label", "presentation", "reason"],
                "properties": {
                  "status": { "const": "unresolved" },
                  "label": { "const": "Consolidated Wording Unresolved" },
                  "presentation": { "const": "section" },
                  "reason": { "type": "string", "minLength": 1, "maxLength": 400 }
                }
              }
            ]
          },
          "recommendedMaintainerAction": {
            "type": "object",
            "additionalProperties": false,
            "required": ["summary", "operations"],
            "properties": {
              "summary": { "type": "string", "minLength": 1, "maxLength": 600 },
              "operations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["candidateKey", "ruleId", "action", "proposedText", "retireHostedRuleIds"],
                  "properties": {
                    "candidateKey": { "type": "string", "minLength": 1 },
                    "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" },
                    "action": { "enum": ["add", "update", "retire", "restore", "exclude", "defer"] },
                    "proposedText": { "type": "string", "minLength": 1 },
                    "retireHostedRuleIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$" } }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
