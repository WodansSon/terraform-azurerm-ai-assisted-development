{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/version-3-field-compatibility.schema.json",
  "title": "Hosted Version 3 Field Compatibility Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "inventoryId", "entries"],
  "properties": {
    "$schema": { "const": "version-3-field-compatibility.schema.json" },
    "schemaVersion": { "const": 1 },
    "inventoryId": { "const": "hosted-version-3-field-compatibility" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "field", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "field": { "type": "string", "minLength": 1 },
        "status": {
          "enum": ["existing-v4-authority", "planned-v4-authority", "derived-projection", "intentional-retirement"]
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "sourceAuthority", "version3Fields", "currentOwnerPath", "v4Destination", "disposition", "evidencePaths"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^V3-COMPAT-[A-Z0-9-]+$" },
        "sourceAuthority": {
          "enum": ["assessment-baseline-schema", "rule-intake-review-schema", "workbench-runtime-state", "workbench-draft", "workbench-approval"]
        },
        "version3Fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "currentOwnerPath": { "$ref": "#/$defs/relativePath" },
        "v4Destination": { "$ref": "#/$defs/destination" },
        "disposition": { "enum": ["preserve", "regenerate", "derive", "intentionally-retire"] },
        "evidencePaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
