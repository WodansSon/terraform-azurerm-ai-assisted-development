{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/version-3-retirement-inventory.schema.json",
  "title": "Hosted Version 3 Retirement Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "inventoryId", "entries"],
  "properties": {
    "$schema": { "const": "version-3-retirement-inventory.schema.json" },
    "schemaVersion": { "const": 1 },
    "inventoryId": { "const": "hosted-version-3-retirement" },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "owner", "status"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "owner": { "type": "string", "minLength": 1 },
        "status": { "enum": ["existing-v4-authority", "planned-v4-authority", "derived-projection", "intentional-retirement"] }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "id", "dependencyClass", "currentOwnerPath", "currentArtifact", "v4Destination", "retirementGate", "archiveEligibility", "evidencePaths"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "id": { "type": "string", "pattern": "^V3-RETIRE-[A-Z0-9-]+$" },
        "dependencyClass": {
          "enum": ["producer", "schema", "durable-artifact", "cache", "session-key", "launcher-parameter", "launcher-default", "staged-filename", "validator-registration", "browser-schema-constant", "browser-field-read", "fixture-family", "renderer-workflow"]
        },
        "currentOwnerPath": { "$ref": "#/$defs/relativePath" },
        "currentArtifact": { "type": "string", "minLength": 1 },
        "v4Destination": { "$ref": "#/$defs/destination" },
        "retirementGate": { "enum": ["preserve-through-phase-7", "phase-7-atomic-switch", "phase-8-zero-active-references", "never-retire"] },
        "archiveEligibility": { "enum": ["archive-after-phase-8-gate", "replace-in-place", "delete-external-after-cutover", "retain-canonical", "not-applicable"] },
        "evidencePaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
        "notes": { "type": "string", "minLength": 1 }
      }
    }
  }
}
