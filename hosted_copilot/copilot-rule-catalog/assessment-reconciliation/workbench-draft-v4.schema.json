{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/assessment-reconciliation/workbench-draft-v4.schema.json",
  "title": "Hosted Rule Workbench Draft Version 4",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "workbenchBundleSha256", "exportedAt", "approverName", "decisions", "applicabilityOverrides", "bulkOperations"],
  "properties": {
    "$schema": { "const": "workbench-draft-v4.schema.json" },
    "schemaVersion": { "const": 4 },
    "kind": { "const": "hosted-rule-workbench-draft" },
    "workbenchBundleSha256": { "$ref": "#/$defs/sha256" },
    "exportedAt": { "type": "string", "format": "date-time" },
    "approverName": { "type": "string", "maxLength": 120 },
    "decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/decision" }
    },
    "applicabilityOverrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/applicabilityOverride" }
    },
    "bulkOperations": {
      "type": "array",
      "items": { "$ref": "#/$defs/bulkOperation" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hostedId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
    "assessmentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentBaselineSha256", "sourceDefinitionId", "sourceId", "contentSha256", "assessmentId"],
      "properties": {
        "assessmentBaselineSha256": { "$ref": "#/$defs/sha256" },
        "sourceDefinitionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "sourceId": { "type": "string", "minLength": 1 },
        "contentSha256": { "$ref": "#/$defs/sha256" },
        "assessmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hostedId", "recommendationSha256", "action", "rationale", "memberAssessmentRefs", "planMembershipSource", "bulkOperationId", "updatedAt"],
      "properties": {
        "hostedId": { "$ref": "#/$defs/hostedId" },
        "recommendationSha256": { "$ref": "#/$defs/sha256" },
        "action": { "enum": ["add", "update", "retire", "restore", "no-change", "defer"] },
        "rationale": { "type": "string", "maxLength": 500 },
        "memberAssessmentRefs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessmentRef" } },
        "planMembershipSource": { "enum": ["manual", "bulk"] },
        "bulkOperationId": { "type": ["string", "null"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "applicabilityOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentRef", "originalHostedApplicable", "effectiveHostedApplicable", "state", "rationale", "recordedBy", "recordedAt"],
      "properties": {
        "assessmentRef": { "$ref": "#/$defs/assessmentRef" },
        "originalHostedApplicable": { "const": false },
        "effectiveHostedApplicable": { "const": true },
        "state": { "const": "provisional" },
        "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recordedBy": { "type": "string", "minLength": 1 },
        "recordedAt": { "type": "string", "format": "date-time" }
      }
    },
    "bulkOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action", "hostedIds", "createdAt"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "action": { "enum": ["add", "update"] },
        "hostedIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/hostedId" } },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
