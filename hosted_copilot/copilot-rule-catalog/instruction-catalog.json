      "introduction": "Apply these rules only when the changed lines introduce or expose an actionable documentation defect. Verify schema- and implementation-dependent claims in `internal/**` before commenting.",
      "sections": [
        { "heading": "Evidence And Coverage", "ruleIds": ["DOCS-EVID-001", "DOCS-ARG-001", "DOCS-ARG-007", "DOCS-ATTR-002"] },
