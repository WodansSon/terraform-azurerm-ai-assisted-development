  "rules": [
    { "id": "IMPL-EVID-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Do not infer Azure field types, required properties, enum values, or PATCH semantics. Verify them against generated SDK models and the selected API version.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-WF-001A", "origin": "hosted-baseline-migration", "status": "active", "text": "Classify implementation code as legacy untyped Plugin SDK, typed `internal/sdk`, or framework-native before suggesting changes. Maintain the existing model unless the task is an explicit migration; use typed for current ordinary resource and data source work, and framework patterns for framework-native or specialized surfaces.", "provenance": ["published-upstream-standard", "confirmed-maintainer-convention"], "sourceIds": ["best-practices", "guide-list-resource"], "evidenceIds": ["implementation-contract", "implementation-model-confirmation"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-WF-002B", "origin": "hosted-baseline-migration", "status": "active", "text": "A create-time import-as-exists check must honor `SkipImportCheckOnCreateAndAllowOverwritingExistingResources`; when the feature is enabled, existing remote resources must not trigger `ImportAsExistsError`.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-new-resource"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-WF-002C", "origin": "hosted-baseline-migration", "status": "active", "text": "When Resource Identity is supported, callback-based create flows must set both the resource ID and identity before returning. Do not defer required identity population until Read.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-resource-identity"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-SCHEMA-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Required, optional, computed, ForceNew, defaults, conflicts, and validation must match actual API and lifecycle behavior. Flag schema declarations that permit invalid requests, reject valid configuration, or cannot round-trip state.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-SCHEMA-004", "origin": "hosted-baseline-migration", "status": "active", "text": "Prefer generated SDK `PossibleValuesFor...()` helpers for enum validation when they represent the accepted set. A narrower validator requires service-specific evidence.", "provenance": ["published-upstream-standard"], "sourceIds": ["schema-design-considerations"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-SCHEMA-006", "origin": "hosted-baseline-migration", "status": "active", "text": "Parse Azure-returned resource IDs with the shared typed parser and write the parser's canonical `.ID()` form to Terraform state. Do not persist raw API ID casing when a parser exists.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-resource-ids"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-SCHEMA-007", "origin": "hosted-baseline-migration", "status": "active", "text": "Do not expose preview-only Azure properties as stable schema before GA unless the provider's explicit feature-gate policy permits them.", "provenance": ["published-upstream-standard"], "sourceIds": ["schema-design-considerations"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-SCHEMA-008", "origin": "hosted-baseline-migration", "status": "active", "text": "When Azure uses a `None`, `Off`, or equivalent sentinel for omission, keep that sentinel out of user-facing validation, expand omitted configuration to the API sentinel, and flatten the sentinel back to omitted state.", "provenance": ["published-upstream-standard"], "sourceIds": ["schema-design-considerations"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-SCHEMA-010", "origin": "hosted-baseline-migration", "status": "active", "text": "An optional `TypeList` block whose nested fields are all optional must enforce a non-empty configured item when an empty block would produce an invalid or meaningless request.", "provenance": ["published-upstream-standard"], "sourceIds": ["schema-design-considerations"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-SCHEMA-013", "origin": "hosted-baseline-migration", "status": "active", "text": "`CustomizeDiff` validation for optional or unknown values must inspect `GetRawConfig()`, distinguish null from configured zero values, and check `IsKnown()` before traversing collections.", "provenance": ["published-upstream-standard", "local-safeguard"], "sourceIds": ["best-practices"], "evidenceIds": ["implementation-contract", "hosted-architecture"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-SCHEMA-017", "origin": "hosted-baseline-migration", "status": "active", "text": "Write-only attributes must use symmetric schema relationships and a positive version trigger so secret rotation is intentional, state-safe, and not driven by perpetual unknown values.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-new-write-only-attribute"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"] },
    { "id": "IMPL-PATCH-001", "origin": "hosted-baseline-migration", "status": "active", "text": "If Azure PATCH preserves omitted properties, removing Terraform configuration must expand an explicit disabled, empty, or sentinel value that clears the remote feature. Returning `nil` is a defect when SDK serialization would omit the field and preserve stale Azure state.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed"], "documentationGap": true },
    { "id": "IMPL-ERR-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Provider errors must be lowercase, add the operation and resource context needed to diagnose the failure, wrap field names and values in backticks, avoid contractions and terminal punctuation, and use `%+v` for underlying errors. Use `errors.New(...)` for static messages that do not wrap an error or require formatting; use `fmt.Errorf(...)` only when formatting values or wrapping context.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-errors", "guide-new-resource"], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "IMPL-ERR-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Return already comprehensive typed resource ID parser errors directly. Wrap them only when the additional context materially improves diagnosis.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["implementation-contract"], "implementationModels": ["legacy", "typed", "framework"] },
    { "id": "TEST-EVID-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Follow the nearest same-service acceptance pattern for naming, configuration helpers, assertions, and scenario shape. Flag a new local pattern only when an established provider pattern covers the same scenario.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-WF-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Resource acceptance coverage should include `basic`, `requiresImport`, `complete`, `update`, and `ImportStep()` when supported. Omission requires concrete evidence that a scenario is not applicable.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-acceptance-testing"], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-WF-002A", "origin": "hosted-baseline-migration", "status": "active", "text": "Optional prerequisites beyond global Azure authentication and locations belong in a receiver `preCheck(t *testing.T)` called by each affected test. Missing optional prerequisites should skip, not fail, and global checks must not be duplicated.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-acceptance-testing"], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-WF-003", "origin": "hosted-baseline-migration", "status": "active", "text": "A new list resource should have Terraform 1.14 query coverage that provisions multiple resources and exercises the base query plus a narrowed query when supported, unless the list resource has an approved exception.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-list-resource"], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-WF-004", "origin": "hosted-baseline-migration", "status": "active", "text": "Ephemeral resource tests should use the service-local framework pattern, Terraform 1.10 gating, framework provider factories, and the `echo` provider when validating result payloads.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"], "documentationGap": true },
    { "id": "TEST-WF-005", "origin": "hosted-baseline-migration", "status": "active", "text": "Provider-defined function tests belong under `internal/provider/function`, use focused framework unit tests and Terraform 1.8 gating, and assert `provider::azurerm::...` output rather than using a resource lifecycle harness.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"], "documentationGap": true },
    { "id": "TEST-PATTERN-001", "origin": "hosted-baseline-migration", "status": "active", "text": "A basic managed-resource test must prove the object exists in Azure, normally with `check.That(data.ResourceName).ExistsInAzure(r)`.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-PATTERN-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Prefer `data.ImportStep()` for broad post-create state validation. Add field assertions only for computed or edge behavior that import cannot prove.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-PATTERN-004", "origin": "hosted-baseline-migration", "status": "active", "text": "Managed resources require dedicated `requiresImport` coverage by default, normally through `data.RequiresImportErrorStep`; omission requires evidence that import collision behavior is not applicable.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-acceptance-testing"], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-PATTERN-005", "origin": "hosted-baseline-migration", "status": "active", "text": "Do not add an acceptance test solely for simple property validation already covered by a unit test; require acceptance coverage only for lifecycle, Azure runtime, or provider behavior beyond the validator.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["testing-contract"] },
    { "id": "TEST-PATTERN-006", "origin": "hosted-baseline-migration", "status": "active", "text": "`CustomizeDiff` constraints need targeted acceptance coverage for invalid paths, normally with `ExpectError`; broader lifecycle scenarios can cover valid paths unless additional assertions are necessary.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["testing-contract", "hosted-architecture"] },
    { "id": "TEST-PATTERN-008", "origin": "hosted-baseline-migration", "status": "active", "text": "Use one canonical helper type for each Terraform resource or data source across main, list, identity, and generated tests. Do not hand-edit generated identity tests or bridge naming drift with aliases or wrappers.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["testing-contract", "hosted-architecture"] },
    { "id": "TEST-PATTERN-010", "origin": "hosted-baseline-migration", "status": "active", "text": "Embedded Terraform configuration must use two-space indentation and no tabs. Go formatting and Go tests do not detect invalid indentation inside raw strings.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["testing-contract", "hosted-architecture"] },
    { "id": "TEST-PATTERN-011", "origin": "hosted-baseline-migration", "status": "active", "text": "When a provider feature changes CRUD, import, overwrite, or destroy behavior, add one focused acceptance scenario for the non-default branch when feasible. Prepare pre-existing remote state with the appropriate `CheckWithClient...` helper instead of a second Terraform resource targeting the same ID.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["testing-contract", "hosted-architecture"] },
    { "id": "TEST-PATTERN-012", "origin": "hosted-baseline-migration", "status": "active", "text": "When a `CheckWithClientForResource`, `CheckWithClientWithoutResource`, or `CheckWithClient` callback invokes an Azure polling helper, wrap its callback context with `context.WithTimeout(...)` or `context.WithDeadline(...)` before polling. Use an operation-appropriate deadline and do not confuse quota failures with missing deadlines.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["testing-contract", "hosted-architecture"] },
    { "id": "DOCS-EVID-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Do not guess about fields, constraints, defaults, conditional requirements, lifecycle behavior, or import IDs. Report a finding only when repository evidence proves the expected behavior.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-ARG-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Every documented argument must exist in schema, and every schema-exposed argument relevant to the documented object must be documented.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-ARG-007", "origin": "hosted-baseline-migration", "status": "active", "text": "Every schema-required argument and nested block must be documented as required and included in the primary example.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-ATTR-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Every user-relevant computed attribute exposed by schema must be documented under **Attributes Reference**.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-FM-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Reference documentation must begin with YAML frontmatter containing `subcategory`, `layout`, `page_title`, and `description`.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards", "guide-list-resource"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-FM-006", "origin": "hosted-baseline-migration", "status": "active", "text": "The frontmatter `layout` must be `azurerm`.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards", "guide-list-resource"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-FMT-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Resource and data source docs must use the exact introductions `The following arguments are supported:` under **Arguments Reference** and `In addition to the Arguments listed above - the following Attributes are exported:` under **Attributes Reference**.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-STRUCT-001", "origin": "hosted-baseline-migration", "status": "active", "text": "Resource documentation must contain **Example Usage**, **Arguments Reference**, **Attributes Reference**, and **Import**. Data source documentation must contain the first three sections and must not contain **Import**.", "provenance": ["published-upstream-standard"], "sourceIds": ["reference-documentation-standards", "guide-new-resource"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-STRUCT-003", "origin": "hosted-baseline-migration", "status": "active", "text": "Include **Timeouts** only when the schema defines timeouts for the documented object.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-EX-000", "origin": "hosted-baseline-migration", "status": "active", "text": "The primary example must be functional for its stated scenario.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-EX-003", "origin": "hosted-baseline-migration", "status": "active", "text": "A resource example must declare every referenced resource, data source, and module needed to apply it.", "provenance": ["local-safeguard"], "sourceIds": [], "evidenceIds": ["documentation-contract", "hosted-architecture"] },
    { "id": "DOCS-EX-005", "origin": "hosted-baseline-migration", "status": "active", "text": "Examples must not hard-code secrets; use input variables for secret values.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-EX-008", "origin": "hosted-baseline-migration", "status": "active", "text": "Reference examples must not include `terraform` or `provider` blocks unless the documented object requires an explicitly supported exception.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-EX-010", "origin": "hosted-baseline-migration", "status": "active", "text": "Example values must satisfy schema validation, enum casing, and cross-field requirements.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-IMP-001", "origin": "hosted-baseline-migration", "status": "active", "text": "A resource import example must match the resource importer or typed resource ID parser exactly.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-IMP-002", "origin": "hosted-baseline-migration", "status": "active", "text": "A resource **Import** section must include a `shell` fenced `terraform import azurerm_<type>.example <resource_id>` command.", "provenance": ["published-upstream-standard"], "sourceIds": ["guide-new-resource"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-FMT-005", "origin": "hosted-baseline-migration", "status": "active", "text": "Argument and attribute entries must use `*` as the Markdown list marker, matching the contributor-guide templates; do not use `-` for these entries.", "provenance": ["published-upstream-standard", "confirmed-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract", "docs-list-marker-confirmation"] },
    { "id": "DOCS-ARG-003", "origin": "hosted-baseline-migration", "status": "active", "text": "A resource argument with `ForceNew: true` must end with the exact sentence `Changing this forces a new resource to be created.` Non-resource documentation must not use ForceNew wording.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-ARG-004", "origin": "hosted-baseline-migration", "status": "active", "text": "A schema default must be documented with a `Defaults to ...` sentence.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-ARG-005", "origin": "hosted-baseline-migration", "status": "active", "text": "A schema validation or enum constraint must be documented using the canonical possible-values wording.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-NOTE-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Cross-field requirements, conflicts, and diff-time constraints that affect valid configuration must be documented and must agree with schema or implementation behavior.", "provenance": ["inferred-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-WORD-002", "origin": "hosted-baseline-migration", "status": "active", "text": "Use `Possible values are ...` for multiple values, `The only possible value is ...` for one value, and `Possible values range between ...` for a numeric range.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-WORD-003", "origin": "hosted-baseline-migration", "status": "active", "text": "Resource summaries start with `Manages`; data source summaries start with `Gets information about`; list-resource summaries start with `Lists`; ephemeral-resource summaries start with `Use this to access information about`; and function summaries describe the function behavior.", "provenance": ["published-upstream-standard", "inferred-maintainer-convention"], "sourceIds": ["reference-documentation-standards", "guide-list-resource"], "evidenceIds": ["documentation-contract"] },
    { "id": "DOCS-WORD-005", "origin": "hosted-baseline-migration", "status": "active", "text": "Use the Oxford comma in every documentation prose list of three or more items, including possible-value lists.", "provenance": ["confirmed-maintainer-convention"], "sourceIds": [], "evidenceIds": ["documentation-contract", "oxford-comma-confirmation"], "documentationGap": true }
  ]
}
