        { "heading": "Examples And Imports", "ruleIds": ["DOCS-EX-000", "DOCS-EX-003", "DOCS-EX-005", "DOCS-EX-008", "DOCS-EX-010", "DOCS-IMP-001", "DOCS-IMP-002"] },
        { "heading": "Argument Accuracy", "ruleIds": ["DOCS-FMT-005", "DOCS-ARG-003", "DOCS-ARG-004", "DOCS-ARG-005", "DOCS-NOTE-002"] },
