{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "parserId", "behaviorFiles", "aggregateSha256"],
  "properties": {
    "$schema": {
      "const": "parser-contract.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "parserId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*-v[1-9][0-9]*$"
    },
    "behaviorFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._/-]+$"
      }
    },
    "aggregateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
