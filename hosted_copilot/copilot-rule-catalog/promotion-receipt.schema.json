{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/promotion-receipt.schema.json",
  "title": "Hosted Rule Promotion Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "receiptId", "planSha256", "promotedAt", "approval", "appliedBy", "sourceSnapshots", "decisions", "fileChanges", "tokenReports", "regressionAssets", "validations", "outcome"],
  "properties": {
    "$schema": { "const": "promotion-receipt.schema.json" },
    "schemaVersion": { "const": 1 },
    "receiptId": { "type": "string", "format": "uuid" },
    "planSha256": { "$ref": "#/$defs/sha256Hash" },
    "promotedAt": { "type": "string", "format": "date-time" },
    "approval": { "$ref": "#/$defs/approval" },
    "appliedBy": { "$ref": "#/$defs/identity" },
    "sourceSnapshots": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sourceSnapshot" } },
    "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
    "fileChanges": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/fileChange" } },
    "tokenReports": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/tokenReport" } },
    "regressionAssets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/relativePath" } },
    "validations": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/validation" } },
    "outcome": { "const": "success" }
  },
  "$defs": {
    "sha256Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ruleId": { "type": "string", "pattern": "^[A-Z]+-[A-Z0-9]+-[0-9]+[A-Z]?$" },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": { "enum": ["github-authenticated", "git-config", "manual"] },
        "id": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedAt", "approvedBy", "method"],
      "properties": {
        "approvedAt": { "type": "string", "format": "date-time" },
        "approvedBy": { "$ref": "#/$defs/identity" },
        "method": { "const": "hosted-rule-workbench" }
      }
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "sha256"],
      "properties": {
        "kind": { "enum": ["upstream-contributor", "interactive-rule"] },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256Hash" }
      }
    },
    "selectionFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scoringStatus"],
      "properties": {
        "scoringStatus": { "enum": ["scored", "not-applicable"] },
        "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "frequency": { "type": "integer", "minimum": 0, "maximum": 5 },
        "breadth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "hostedDetectability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "falsePositiveRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "redundancy": { "type": "integer", "minimum": 0, "maximum": 5 }
      },
      "allOf": [
        {
          "if": { "properties": { "scoringStatus": { "const": "scored" } } },
          "then": { "required": ["severity", "frequency", "breadth", "hostedDetectability", "evidenceStrength", "falsePositiveRisk", "redundancy"] }
        }
      ]
    },
    "foundationalOverride": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["rationale", "affectedHostedRuleIds", "affectedSurfaces"],
      "properties": {
        "rationale": { "type": "string", "minLength": 1 },
        "affectedHostedRuleIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } },
        "affectedSurfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["repository", "implementation", "testing", "documentation", "review-skill"] }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceRef", "action", "hostedRuleIds", "sectionPlacement", "selectionFactors", "selectionRationale", "foundationalOverride"],
      "properties": {
        "sourceRef": { "type": "string", "minLength": 1 },
        "action": { "enum": ["no-change", "add", "update", "retire", "exclude", "defer"] },
        "hostedRuleIds": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/ruleId" } },
        "sectionPlacement": { "type": ["string", "null"] },
        "selectionFactors": { "$ref": "#/$defs/selectionFactors" },
        "selectionRationale": { "type": "string", "minLength": 1 },
        "foundationalOverride": { "$ref": "#/$defs/foundationalOverride" }
      }
    },
    "fileChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operation", "beforeSha256", "afterSha256"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "operation": { "enum": ["add", "update"] },
        "beforeSha256": { "oneOf": [{ "$ref": "#/$defs/sha256Hash" }, { "type": "null" }] },
        "afterSha256": { "$ref": "#/$defs/sha256Hash" }
      }
    },
    "tokenReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "beforeGuardedTokens", "afterGuardedTokens", "budgetTokens", "budgetHeadroomTokens", "utilizationPercent"],
      "properties": {
        "name": { "enum": ["repository", "go", "test", "documentation", "skill", "go-combined", "test-combined", "documentation-combined"] },
        "beforeGuardedTokens": { "type": "integer", "minimum": 0 },
        "afterGuardedTokens": { "type": "integer", "minimum": 0 },
        "budgetTokens": { "type": "integer", "minimum": 1 },
        "budgetHeadroomTokens": { "type": "integer" },
        "utilizationPercent": { "type": "number", "minimum": 0 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "completedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "status": { "const": "passed" },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  }
}
