{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/rule-assessments/assessment-baseline.schema.json",
  "title": "Hosted Rule Assessment Baseline",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "generatedAt", "hostedCatalogSha256", "sourceBundleSha256", "entries"],
  "properties": {
    "$schema": { "const": "assessment-baseline.schema.json" },
    "schemaVersion": { "const": 3 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "hostedCatalogSha256": { "$ref": "#/$defs/sha256Hash" },
    "sourceBundleSha256": { "$ref": "#/$defs/sha256Hash" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/baselineEntry" }
    }
  },
  "$defs": {
    "sha256Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "selectionFactors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "frequency", "breadth", "hostedDetectability", "evidenceStrength", "falsePositiveRisk", "redundancy"],
      "properties": {
        "severity": { "type": "integer", "minimum": 0, "maximum": 5 },
        "frequency": { "type": "integer", "minimum": 0, "maximum": 5 },
        "breadth": { "type": "integer", "minimum": 0, "maximum": 5 },
        "hostedDetectability": { "type": "integer", "minimum": 0, "maximum": 5 },
        "evidenceStrength": { "type": "integer", "minimum": 0, "maximum": 5 },
        "falsePositiveRisk": { "type": "integer", "minimum": 0, "maximum": 5 },
        "redundancy": { "type": "integer", "minimum": 0, "maximum": 5 }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessmentId", "title", "candidateState", "targetHostedRuleId", "proposedHostedRuleId", "status", "sourceContentSha256", "assessedAt", "evaluator", "hostedApplicable", "applicabilityRationale", "hostedCategory", "recommendation", "summary", "impactDescription", "currentHostedCoverage", "affectedSurfaces", "guardedTokenDelta", "proposedText", "selectionFactors", "selectionRationale"],
      "properties": {
        "assessmentId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9-]*$" },
        "title": { "type": "string", "minLength": 1 },
        "candidateState": { "enum": ["new", "changed", "retired", "deferred", "current"] },
        "targetHostedRuleId": {
          "oneOf": [
            { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
            { "type": "null" }
          ]
        },
        "proposedHostedRuleId": { "type": "string", "maxLength": 32, "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
        "status": { "const": "evaluated" },
        "sourceContentSha256": { "$ref": "#/$defs/sha256Hash" },
        "assessedAt": { "type": "string", "format": "date-time" },
        "evaluator": { "type": "string", "minLength": 1 },
        "hostedApplicable": { "type": "boolean" },
        "applicabilityRationale": { "type": "string", "minLength": 1 },
        "hostedCategory": { "enum": ["repository", "review-classification-and-evidence", "implementation", "testing", "documentation"] },
        "recommendation": { "enum": ["add", "update", "retire", "no-change", "exclude", "defer"] },
        "summary": { "type": "string", "minLength": 1 },
        "impactDescription": { "type": "string", "minLength": 1 },
        "currentHostedCoverage": { "type": "string", "minLength": 1 },
        "affectedSurfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["repository", "implementation", "testing", "documentation", "review-skill"] }
        },
        "guardedTokenDelta": { "type": "integer" },
        "proposedText": { "type": "string", "minLength": 1 },
        "selectionFactors": { "$ref": "#/$defs/selectionFactors" },
        "selectionRationale": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "properties": {
            "proposedHostedRuleId": { "type": "string" },
            "affectedSurfaces": { "minItems": 1 }
          }
        },
        {
          "if": { "properties": { "hostedApplicable": { "const": false } }, "required": ["hostedApplicable"] },
          "then": { "properties": { "recommendation": { "const": "exclude" }, "guardedTokenDelta": { "const": 0 } } }
        }
      ]
    },
    "baselineEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType", "id", "sourceContentSha256", "assessments"],
      "properties": {
        "sourceType": { "enum": ["interactive", "maintainer", "upstream"] },
        "id": { "type": "string", "minLength": 1 },
        "sourceContentSha256": { "$ref": "#/$defs/sha256Hash" },
        "assessments": {
          "type": "array",
          "items": { "$ref": "#/$defs/assessment" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "sourceType": { "const": "upstream" } }, "required": ["sourceType"] },
          "then": {
            "properties": {
              "id": { "pattern": "^[a-z][a-z0-9-]*$" }
            }
          },
          "else": {
            "properties": {
              "id": { "pattern": "^[A-Z]+(?:-[A-Z0-9]+)+-[0-9]{3}[A-Z]?$" },
              "assessments": { "minItems": 1, "maxItems": 1 }
            }
          }
        }
      ]
    }
  }
}
