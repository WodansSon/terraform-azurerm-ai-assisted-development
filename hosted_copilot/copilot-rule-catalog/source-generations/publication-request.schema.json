{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/source-generations/publication-request.schema.json",
  "title": "Hosted Source Generation Publication Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "workbenchBundleSha256", "acceptance"],
  "properties": {
    "$schema": {
      "const": "publication-request.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "hosted-source-generation-publication-request"
    },
    "workbenchBundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": {
          "enum": ["github-authenticated", "git-config", "manual"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedAt", "acceptedBy", "rationale"],
      "properties": {
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedBy": {
          "$ref": "#/$defs/identity"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
