{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/copilot-rule-catalog/source-generations/source-generation.schema.json",
  "title": "Hosted Accepted Source Generation",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "publishedAt", "previousSourceGenerationSha256", "workbenchBundleSha256", "publicationRequestSha256", "hostedCatalogSha256", "acceptance", "inventories", "assessmentBaseline"],
  "properties": {
    "$schema": {
      "const": "source-generation.schema.json"
    },
    "schemaVersion": {
      "const": 1
    },
    "publishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "previousSourceGenerationSha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "workbenchBundleSha256": {
      "$ref": "#/$defs/sha256"
    },
    "publicationRequestSha256": {
      "$ref": "#/$defs/sha256"
    },
    "hostedCatalogSha256": {
      "$ref": "#/$defs/sha256"
    },
    "acceptance": {
      "$ref": "#/$defs/acceptance"
    },
    "inventories": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "assessmentBaseline": {
      "type": "object"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "displayName"],
      "properties": {
        "type": {
          "enum": ["github-authenticated", "git-config", "manual"]
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["acceptedAt", "acceptedBy", "rationale"],
      "properties": {
        "acceptedAt": {
          "type": "string",
          "format": "date-time"
        },
        "acceptedBy": {
          "$ref": "#/$defs/identity"
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    }
  }
}
