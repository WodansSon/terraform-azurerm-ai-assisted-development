{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wodansson.github.io/terraform-azurerm-ai-assisted-development/hosted_copilot/tools/tool-command-surface.schema.json",
  "title": "Hosted Tool Command Surface Move Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schemaVersion", "kind", "phase", "entries"],
  "properties": {
    "$schema": { "const": "tool-command-surface.schema.json" },
    "schemaVersion": { "const": 1 },
    "kind": { "const": "hosted-tool-command-surface-move-plan" },
    "phase": { "const": "2.5" },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "currentPath", "classification", "plannedPath", "purpose", "documentationPath", "retirementInventoryId"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1 },
        "currentPath": { "$ref": "#/$defs/relativePath" },
        "classification": {
          "enum": ["maintainer-command", "internal-implementation", "module", "focused-test", "migration-only", "legacy-v3"]
        },
        "plannedPath": { "$ref": "#/$defs/relativePath" },
        "purpose": { "type": "string", "minLength": 1 },
        "documentationPath": {
          "oneOf": [
            { "$ref": "#/$defs/relativePath" },
            { "type": "null" }
          ]
        },
        "retirementInventoryId": {
          "oneOf": [
            { "type": "string", "pattern": "^V3-RETIRE-[A-Z0-9-]+$" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "classification": { "const": "maintainer-command" } }, "required": ["classification"] },
          "then": {
            "properties": {
              "plannedPath": { "pattern": "^hosted_copilot/tools/(?:[^/]+\\.ps1|commands/(?:catalog|review)/[^/]+\\.ps1)$" },
              "documentationPath": { "$ref": "#/$defs/relativePath" },
              "retirementInventoryId": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "classification": { "const": "module" } }, "required": ["classification"] },
          "then": {
            "properties": {
              "plannedPath": { "pattern": "^hosted_copilot/tools/modules/.+\\.psm1$" },
              "documentationPath": { "type": "null" },
              "retirementInventoryId": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "classification": { "const": "migration-only" } }, "required": ["classification"] },
          "then": {
            "properties": {
              "documentationPath": { "type": "null" },
              "retirementInventoryId": { "type": "string", "pattern": "^V3-RETIRE-MIGRATION-[A-Z0-9-]+$" }
            }
          }
        }
      ]
    }
  }
}
